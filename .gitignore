# ════════════════════════════════════════════════════════════════════
# Tesla App — .gitignore
# ════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────
# 1. Sécurité — NE JAMAIS COMMIT
# ──────────────────────────────────────────────────────────

# Variables d'environnement (DB creds, OAuth Tesla secret, clé sodium, etc.)
# Approche défensive : tout .env ignoré, seul .env.example est partagé
.env*
!.env.example
!.env.dist

# Credentials Composer (token Packagist privé, GitHub OAuth)
auth.json

# Clés privées (OAuth Tesla, TLS, JWT signing) — défense en profondeur
# Tous les .pem et .key ignorés par défaut, sauf la public_key OAuth Tesla
# qui DOIT être servie publiquement à /.well-known/appspecific/
*.pem
*.key
!www/.well-known/appspecific/com.tesla.3p.public-key.pem

# Dumps BDD, archives chiffrées, certificats binaires
*.dump
*.sql.gz
*.sql.bak
*.p12
*.pfx
*.jks


# ──────────────────────────────────────────────────────────
# 2. PHP / Composer
# ──────────────────────────────────────────────────────────

# Dépendances Composer (installées via `composer install`)
/vendor/*
!/vendor/.gitkeep

# Outil Composer
composer.phar


# ──────────────────────────────────────────────────────────
# 3. Outils qualité PHP
# ──────────────────────────────────────────────────────────

# PHPUnit
/.phpunit.cache/
.phpunit.result.cache

# PHPStan
.phpstan.cache/

# php-cs-fixer / phpcs
.php-cs-fixer.cache
.php_cs.cache
.phpcs-cache

# Psalm
.psalm/
psalm.cache/


# ──────────────────────────────────────────────────────────
# 4. Node.js / Frontend build
# ──────────────────────────────────────────────────────────

# Tailwind compiled output — built from assets/css/app.css
# Generate locally with `bun dev`, or via `docker build` for production.
/www/_assets/css/styles.css

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*


# ──────────────────────────────────────────────────────────
# 5. Runtime / Cache / Coverage
# ──────────────────────────────────────────────────────────

# Artefacts runtime (logs, cache PHP, coverage HTML — cf. structure-dossiers §1.1)
/var/

# Logs applicatifs
*.log
logs/


# ──────────────────────────────────────────────────────────
# 6. IDE & Éditeurs
# ──────────────────────────────────────────────────────────

### JetBrains template
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio, WebStorm and Rider
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf

# AWS User-specific
.idea/**/aws.xml

# Generated files
.idea/**/contentModel.xml

# Sensitive or high-churn files
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml

# Gradle
.idea/**/gradle.xml
.idea/**/libraries

# Gradle and Maven with auto-import
# When using Gradle or Maven with auto-import, you should exclude module files,
# since they will be recreated, and may cause churn.  Uncomment if using
# auto-import.
# .idea/artifacts
# .idea/compiler.xml
# .idea/jarRepositories.xml
# .idea/modules.xml
# .idea/*.iml
# .idea/modules
# *.iml
# *.ipr

# CMake
cmake-build-*/

# Mongo Explorer plugin
.idea/**/mongoSettings.xml

# File-based project format
*.iws

# IntelliJ
out/

# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

# Cursive Clojure plugin
.idea/replstate.xml

# SonarLint plugin
.idea/sonarlint/

# Crashlytics plugin (for Android Studio and IntelliJ)
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Editor-based Rest Client
.idea/httpRequests

# Android studio 3.1+ serialized cache file
.idea/caches/build_file_checksums.ser

.idea/*.iml
.idea/shelf/
.idea/dataSources.local.xml

# VS Code
.vscode/

# Vim
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# VSCode Local History extension
.history/

# Backups & merge conflicts résolus
*.bak
*.orig
*.rej
*.backup

# Dossiers temporaires ad-hoc
tmp/
temp/


# ──────────────────────────────────────────────────────────
# 7. Système d'exploitation
# ──────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*


# ──────────────────────────────────────────────────────────
# 8. SonarQube / SonarLint
# ──────────────────────────────────────────────────────────

.sonar/
.sonarqube/
.scannerwork/
.sonarlint/


# ──────────────────────────────────────────────────────────
# 9. Docker (volumes locaux : Postgres, Kafka, fleet-telemetry)
# ──────────────────────────────────────────────────────────

docker/data/
.docker-volumes/
docker-compose.override.yml


# ──────────────────────────────────────────────────────────
# 10. Outils dev personnels (Claude Code) — local uniquement
# ──────────────────────────────────────────────────────────

CLAUDE.md
.claude/
references/
