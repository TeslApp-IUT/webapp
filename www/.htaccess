# .htaccess — TeslApp (www/ = DocumentRoot)

RewriteEngine On

# ─── Force HTTPS (tient compte d'un reverse proxy via X-Forwarded-Proto) ───
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── En-têtes de sécurité (OWASP) ───
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set X-XSS-Protection "0"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "default-src 'self' https://tesla.com https://*.tesla.com; script-src 'self' https://tesla.com https://*.tesla.com; style-src 'self' https://tesla.com https://*.tesla.com; img-src 'self' data: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://tesla.com https://*.tesla.com; font-src 'self' https://tesla.com https://*.tesla.com; connect-src 'self' https://tesla.com https://*.tesla.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
Header always unset X-Powered-By
Header always unset Server
ServerSignature Off
Options -Indexes

# ─── Canonicalisation : /site/* -> /* ───
RewriteCond %{REQUEST_URI} ^/site/home/?$
RewriteRule ^site/home/?$ %{REQUEST_SCHEME}://%{HTTP_HOST}/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/site/sitemap/?$
RewriteRule ^site/sitemap/?$ %{REQUEST_SCHEME}://%{HTTP_HOST}/sitemap [R=301,L]
RewriteCond %{REQUEST_URI} ^/site/legal/?$
RewriteRule ^site/legal/?$ %{REQUEST_SCHEME}://%{HTTP_HOST}/legal [R=301,L]
RewriteCond %{REQUEST_URI} ^/site/privacy/?$
RewriteRule ^site/privacy/?$ %{REQUEST_SCHEME}://%{HTTP_HOST}/privacy [R=301,L]

# ─── Front controller : tout vers index.php sauf fichiers/dossiers existants ───
# index.php dérive la route depuis REQUEST_URI (cf. www/index.php), pas de ?route=.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

DirectoryIndex index.php

# ─── Compression ───
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/css text/javascript
        AddOutputFilterByType DEFLATE application/javascript application/json
        AddOutputFilterByType DEFLATE text/xml application/xml image/svg+xml
    </IfModule>
</IfModule>
