# Docker Compose file selection (Docker Compose reads this automatically)
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# Environment: local, dev, or prod
ENVIRONMENT=local
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teslapp
DB_USER=postgres
DB_PASS=yourpassword

# Tesla Developer Variables
CLIENT_ID=
CLIENT_SECRET=
TESLA_FLEET_API_URL=https://proxy.teslapp.feyli.dev

# Sodium key (base64 of 32 bytes) used to encrypt the OAuth tokens stored in oauth2_token.
TESLAPP_TOKEN_ENCRYPTION_KEY=
