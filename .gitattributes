# Normalise les fins de ligne : LF dans le dépôt pour tous les fichiers texte,
# quelle que soit la plateforme (évite les CRLF venant de Windows/WSL).
* text=auto eol=lf

# Fichiers binaires : ne jamais toucher aux fins de ligne.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
