{
  "name": "teslapp/app",
  "description": "Tesla App — application web reproduisant des fonctionnalités de l'application Tesla via son API simulée (SAÉ S4.A&B.01, IUT).",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-sodium": "*",
    "ext-curl": "*",
    "ext-pdo": "*",
    "ext-mbstring": "*"
  },
  "scripts": {
    "phpstan": "phpstan analyse",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite=Unit"
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.0"
  }
}
